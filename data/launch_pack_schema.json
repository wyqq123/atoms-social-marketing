{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atoms-social-marketing/launch_pack_schema",
  "$schema_version": "0.2.0",
  "title": "Launch Pack",
  "description": "atoms-social-marketing skill pipeline 顶层产物。Stage 5 组装。",
  "type": "object",
  "required": [
    "$schema_version",
    "generated_at",
    "launch_brief",
    "platform_fit",
    "strategies",
    "deliverables",
    "schedule",
    "checks",
    "_pipeline_meta"
  ],
  "properties": {
    "$schema_version": { "type": "string", "const": "0.2.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "launch_brief": {
      "type": "object",
      "required": ["app_name", "one_liner", "promo_goal", "target_audience", "key_selling_point"],
      "properties": {
        "app_name": { "type": "string" },
        "one_liner": { "type": "string", "maxLength": 100 },
        "promo_goal": { "type": "string" },
        "target_audience": { "type": "string" },
        "key_selling_point": { "type": "string" },
        "primary_market": { "type": "array", "items": { "type": "string" } }
      }
    },
    "platform_fit": {
      "type": "object",
      "required": ["ranking", "scores"],
      "properties": {
        "ranking": { "type": "array", "items": { "$ref": "#/definitions/PlatformId" } },
        "probe_shortlist": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "scores": {
          "type": "object",
          "patternProperties": {
            "^(instagram|youtube|tiktok|reddit|x|linkedin|pinterest|rednote|douyin)$": { "$ref": "#/definitions/PlatformFitScore" }
          },
          "additionalProperties": false
        },
        "opportunity_evidence_briefs": {
          "type": "array",
          "items": { "$ref": "opportunity_evidence_brief_schema.json" }
        },
        "_rationale": { "type": "string" }
      }
    },
    "strategies": {
      "type": "object",
      "patternProperties": {
        "^(instagram|youtube|tiktok|reddit|x|linkedin|pinterest|rednote|douyin)$": { "$ref": "#/definitions/PlatformStrategy" }
      },
      "additionalProperties": false
    },
    "deliverables": {
      "type": "object",
      "patternProperties": {
        "^(instagram|youtube|tiktok|reddit|x|linkedin|pinterest|rednote|douyin)$": {
          "type": "object",
          "required": ["posts"],
          "properties": {
            "posts": { "type": "array", "items": { "$ref": "#/definitions/Caption" } },
            "storyboards": { "type": "array", "items": { "$ref": "#/definitions/Storyboard" } },
            "ab_variants": { "type": "array", "items": { "$ref": "#/definitions/Caption" } }
          }
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": ["week_1"],
      "properties": {
        "week_1": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["day", "platform", "post_ref", "recommended_time"],
            "properties": {
              "day": { "type": "string" },
              "date_offset_from_launch": { "type": "integer", "minimum": 0 },
              "platform": { "$ref": "#/definitions/PlatformId" },
              "post_ref": { "type": "string" },
              "recommended_time": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "checks": {
      "type": "object",
      "required": ["blocker", "warning", "info"],
      "properties": {
        "blocker": { "type": "array", "items": { "type": "string" } },
        "warning": { "type": "array", "items": { "type": "string" } },
        "info": { "type": "array", "items": { "type": "string" } }
      }
    },
    "_pipeline_meta": {
      "type": "object",
      "required": [
        "playbook_versions",
        "platform_registry_version",
        "confidence_summary",
        "ga4_used",
        "media_generation_deferred",
        "injectable_prompts_count"
      ],
      "properties": {
        "playbook_versions": { "type": "object", "additionalProperties": { "type": "string" } },
        "platform_registry_version": { "type": "string" },
        "trend_snapshot_last_refresh": { "type": ["string", "null"] },
        "probe_meta": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "global_timeout_ms": { "type": "integer" },
            "platforms_attempted": { "type": "array", "items": { "type": "string" } },
            "briefs_usable_count": { "type": "integer", "minimum": 0 }
          }
        },
        "confidence_summary": {
          "type": "object",
          "patternProperties": {
            "^(instagram|youtube|tiktok|reddit|x|linkedin|pinterest|rednote|douyin)$": {
              "type": "string",
              "enum": ["low", "medium", "medium-high", "high"]
            }
          },
          "additionalProperties": false
        },
        "ga4_used": { "type": "boolean" },
        "media_generation_deferred": { "type": "boolean", "const": true },
        "injectable_prompts_count": {
          "type": "object",
          "required": ["images", "videos"],
          "properties": {
            "images": { "type": "integer", "minimum": 0 },
            "videos": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "definitions": {
    "PlatformId": {
      "type": "string",
      "enum": ["instagram", "youtube", "tiktok", "reddit", "x", "linkedin", "pinterest", "rednote", "douyin"]
    },
    "PlatformFitScore": {
      "type": "object",
      "required": [
        "fit_score",
        "stable_fit_score",
        "realtime_adjustment",
        "score_confidence",
        "probe_status",
        "subscores",
        "audience_intersection",
        "recommended_surfaces",
        "why_this_platform",
        "why_now",
        "risks",
        "_evidence_refs"
      ],
      "properties": {
        "fit_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "stable_fit_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "realtime_adjustment": { "type": "integer", "minimum": -5, "maximum": 10 },
        "score_confidence": { "type": "string", "enum": ["low", "medium", "medium-high", "high"] },
        "probe_status": { "type": "string", "enum": ["usable", "weak", "unavailable", "timeout", "error", "skipped", "partial", "not_run"] },
        "subscores": {
          "type": "object",
          "required": [
            "icp_reach_quality",
            "mindset_intent_fit",
            "value_expression_fit",
            "distribution_feasibility",
            "conversion_path_fit",
            "production_feasibility"
          ],
          "properties": {
            "icp_reach_quality": { "type": "integer", "minimum": 0, "maximum": 30 },
            "mindset_intent_fit": { "type": "integer", "minimum": 0, "maximum": 20 },
            "value_expression_fit": { "type": "integer", "minimum": 0, "maximum": 15 },
            "distribution_feasibility": { "type": "integer", "minimum": 0, "maximum": 15 },
            "conversion_path_fit": { "type": "integer", "minimum": 0, "maximum": 10 },
            "production_feasibility": { "type": "integer", "minimum": 0, "maximum": 10 }
          }
        },
        "audience_intersection": {
          "type": "object",
          "required": ["matched_dimensions", "missing_dimensions", "reachable_icp_scale", "quality"],
          "properties": {
            "matched_dimensions": { "type": "array", "items": { "type": "string" } },
            "missing_dimensions": { "type": "array", "items": { "type": "string" } },
            "reachable_icp_scale": { "type": "string" },
            "quality": { "type": "string" }
          }
        },
        "recommended_surfaces": { "type": "array", "items": { "type": "string" } },
        "why_this_platform": { "type": "array", "items": { "type": "string" } },
        "why_now": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "_evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PlatformStrategy": {
      "type": "object",
      "required": ["platform", "angles", "hashtag_mix", "posting_cadence"],
      "properties": {
        "platform": { "$ref": "#/definitions/PlatformId" },
        "angles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["angle_id", "core_message", "hook_pattern", "post_type"],
            "properties": {
              "angle_id": { "type": "string" },
              "core_message": { "type": "string" },
              "hook_pattern": { "type": "string" },
              "post_type": { "type": "string" },
              "narrative_arc": { "type": "string" },
              "estimated_fit": { "type": "string", "enum": ["low", "medium", "high"] }
            }
          }
        },
        "hashtag_mix": {
          "type": "object",
          "required": ["slots"],
          "properties": {
            "slots": {
              "type": "object",
              "required": ["1_broad", "2_mid_1", "3_mid_2", "4_niche", "5_brand"],
              "properties": {
                "1_broad": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "2_mid_1": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "3_mid_2": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "4_niche": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "5_brand": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            }
          }
        },
        "posting_cadence": {
          "type": "object",
          "properties": {
            "week_1_frequency": { "type": "string" },
            "best_time_slots": { "type": "array", "items": { "type": "string" } },
            "rationale_ref": { "type": "string" }
          }
        },
        "trend_borrow": {
          "type": ["object", "null"],
          "properties": {
            "source": { "type": "string", "enum": ["usable_evidence", "manual_cache", "authorized_insight", "none"] },
            "evidence_refs": { "type": "array", "items": { "type": "string" } },
            "borrowed_terms": { "type": "array", "items": { "type": "string" } },
            "snapshot_date": { "type": "string" },
            "usage_boundary": { "type": "string" }
          }
        },
        "_rationale": { "type": "string" }
      }
    },
    "Caption": {
      "type": "object",
      "required": ["angle_id", "platform", "post_type", "hook", "body", "cta", "hashtags", "confidence"],
      "properties": {
        "angle_id": { "type": "string" },
        "platform": { "$ref": "#/definitions/PlatformId" },
        "post_type": { "type": "string" },
        "hook": { "type": "string" },
        "body": { "type": "string" },
        "cta": {
          "type": "object",
          "required": ["text", "link_style"],
          "properties": {
            "text": { "type": "string" },
            "link_style": { "type": "string", "enum": ["bio-link", "description-link", "comment-pin", "dm", "profile-link", "swipe-up", "none"] }
          }
        },
        "hashtags": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "media_prompts": { "$ref": "#/definitions/MediaPromptsCaption" },
        "_rationale": { "type": "string" }
      }
    },
    "Storyboard": {
      "type": "object",
      "required": ["angle_id", "platform", "post_type", "total_duration_s", "scenes", "caption"],
      "properties": {
        "angle_id": { "type": "string" },
        "platform": { "$ref": "#/definitions/PlatformId" },
        "post_type": { "type": "string" },
        "total_duration_s": { "type": "integer", "minimum": 5, "maximum": 600 },
        "sound_ref": {
          "type": ["object", "null"],
          "properties": {
            "source": { "type": "string" },
            "sound_id": { "type": "string" },
            "decay_window_days_left": { "type": "integer" }
          }
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scene_id", "duration_s", "purpose", "visual_note", "media_prompts"],
            "properties": {
              "scene_id": { "type": "integer" },
              "duration_s": { "type": "integer" },
              "purpose": { "type": "string", "enum": ["hook", "context", "reveal", "proof", "cta", "loop"] },
              "visual_note": { "type": "string" },
              "text_overlay": { "type": ["string", "null"] },
              "voiceover_or_dialogue": { "type": ["string", "null"] },
              "b_roll_hint": { "type": ["string", "null"] },
              "media_prompts": { "$ref": "#/definitions/MediaPromptsScene" }
            }
          }
        },
        "caption": { "$ref": "#/definitions/Caption" },
        "_rationale": { "type": "string" }
      }
    },
    "MediaPromptsCaption": {
      "type": "object",
      "properties": {
        "cover_image": {
          "type": ["object", "null"],
          "required": ["trigger", "injectable_prompt", "aspect_ratio"],
          "properties": {
            "trigger": { "type": "string", "const": "on-demand" },
            "injectable_prompt": { "type": "string", "minLength": 20 },
            "target_tool_hint": { "type": "string" },
            "aspect_ratio": { "type": "string", "enum": ["1:1", "9:16", "16:9", "4:5", "2:3"] }
          }
        },
        "carousel_slides": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["trigger", "injectable_prompt", "aspect_ratio"],
            "properties": {
              "trigger": { "type": "string", "const": "on-demand" },
              "injectable_prompt": { "type": "string", "minLength": 20 },
              "target_tool_hint": { "type": "string" },
              "aspect_ratio": { "type": "string" },
              "slide_index": { "type": "integer" }
            }
          }
        }
      }
    },
    "MediaPromptsScene": {
      "type": "object",
      "required": ["trigger"],
      "properties": {
        "trigger": { "type": "string", "const": "on-demand" },
        "video_prompt": {
          "type": ["object", "null"],
          "required": ["injectable_prompt", "aspect_ratio", "duration_hint_s"],
          "properties": {
            "injectable_prompt": { "type": "string", "minLength": 20 },
            "target_tool_hint": { "type": "string" },
            "aspect_ratio": { "type": "string" },
            "duration_hint_s": { "type": "integer" }
          }
        },
        "image_prompt": {
          "type": ["object", "null"],
          "required": ["injectable_prompt", "aspect_ratio"],
          "properties": {
            "injectable_prompt": { "type": "string", "minLength": 20 },
            "target_tool_hint": { "type": "string" },
            "aspect_ratio": { "type": "string" }
          }
        }
      }
    }
  }
}
