{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atoms-social-marketing/inputs_schema",
  "$schema_version": "0.2.0",
  "title": "Launch Pack Pipeline Inputs",
  "description": "atoms-social-marketing skill 的 pipeline 输入契约。上层调用方负责收集并按此结构传入。注意区分 builder（应用创建者）、built app（被推广应用）与 app end users（应用终端用户）。",
  "type": "object",
  "required": ["app_context", "builder_prompt", "positioning"],
  "properties": {
    "app_context": {
      "type": "object",
      "required": ["name", "description", "category"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 100, "maxLength": 500 },
        "category": { "type": "string", "description": "参考 Atoms 品类枚举" },
        "target_market": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "default": ["US"]
        },
        "urls": {
          "type": "object",
          "properties": {
            "product": { "type": "string", "format": "uri" },
            "docs": { "type": "string", "format": "uri" },
            "landing": { "type": "string", "format": "uri" }
          }
        },
        "screenshots_ref": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "builder_prompt": {
      "type": "string",
      "minLength": 50,
      "description": "Atoms builder（应用创建者）构建 built app 时的原始 prompt。只能作为 app/context/素材/约束线索,不能直接当作终端用户画像。"
    },
    "positioning": {
      "type": "object",
      "required": ["promo_goal", "target_audience", "key_selling_point"],
      "properties": {
        "promo_goal": {
          "type": "string",
          "description": "推广目标, e.g. '冷启动首周破 1000 registered users'"
        },
        "target_audience": {
          "type": "string",
          "description": "built app 的终端用户画像,不是 builder 自画像。e.g. 'Shopify sellers who need faster product-page copy' 或 'local gym owners trying to get more bookings'"
        },
        "key_selling_point": {
          "type": "string",
          "description": "想突出的产品卖点, e.g. '零代码 15 分钟上线一个能收钱的 landing page'"
        }
      }
    },
    "production_context": {
      "type": "object",
      "description": "可选。builder 为推广 built app 可提供的素材与制作约束。只用于 builder_context / production_constraints,不得写入 built app 终端用户 ICP。",
      "properties": {
        "available_assets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["built_app_screenshots", "built_app_demo_recording", "built_app_landing_page", "customer_testimonials", "founder_story", "brand_assets", "analytics_snapshot", "none"]
          },
          "uniqueItems": true
        },
        "channel_preferences": {
          "type": "array",
          "items": { "type": "string" },
          "description": "builder 明确偏好的发布渠道;不是 built app 终端用户画像。"
        },
        "creator_constraints": {
          "type": "object",
          "properties": {
            "can_record_founder_video": { "type": "boolean" },
            "can_create_short_video": { "type": "boolean" },
            "has_customer_proof": { "type": "boolean" },
            "weekly_content_capacity": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
            "notes": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ga4_snapshot": {
      "description": "可选。用户 app 内集成 GA4 后,上层调 skill 前拉取的 GA4 汇总快照。口径见 data/ga4_snapshot_schema.json 与 references/ga4-snapshot-contract.md。未集成则为 null。",
      "oneOf": [{ "type": "null" }, { "$ref": "ga4_snapshot_schema.json" }]
    },
    "platform_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["instagram", "youtube", "tiktok", "reddit", "x", "linkedin", "pinterest", "rednote", "douyin"]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["instagram", "youtube", "tiktok", "reddit"],
      "description": "发布平台候选。Stage 2 可额外使用 web_search 作为 evidence fallback,但 web_search 不作为发布平台。旧别名 ig/yt/tt 应在上层映射为 instagram/youtube/tiktok。"
    },
    "probe_options": {
      "type": "object",
      "description": "可选。控制 Stage 2b 实时/缓存探针预算。",
      "properties": {
        "enable_realtime_probe": { "type": "boolean", "default": true },
        "no_network": { "type": "boolean", "default": false },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 12000, "default": 8000 },
        "max_platforms": { "type": "integer", "minimum": 1, "maximum": 3, "default": 3 },
        "queries_per_platform": { "type": "integer", "minimum": 1, "maximum": 3, "default": 3 },
        "fresh_cache_max_age_hours": { "type": "integer", "minimum": 1, "maximum": 336, "default": 24 }
      },
      "additionalProperties": false
    }
  }
}


